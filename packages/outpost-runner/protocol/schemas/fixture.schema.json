{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outpost.dev/schemas/orp/v1/fixture.schema.json",
  "title": "ORP scripted replay fixture",
  "type": "object",
  "required": [
    "schema",
    "fixtureVersion",
    "protocolVersion",
    "name",
    "description",
    "identity",
    "capabilities",
    "commands",
    "events",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "outpost.orp.fixture.v1"
    },
    "fixtureVersion": {
      "const": 1
    },
    "protocolVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "identity": {
      "$ref": "https://outpost.dev/schemas/orp/v1/identity.schema.json"
    },
    "capabilities": {
      "oneOf": [
        {
          "$ref": "https://outpost.dev/schemas/orp/v1/capabilities.schema.json"
        },
        {
          "$ref": "https://outpost.dev/schemas/orp/v2/capabilities.schema.json"
        },
        {
          "$ref": "https://outpost.dev/schemas/orp/v3/capabilities.schema.json"
        }
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://outpost.dev/schemas/orp/v1/command.schema.json"
          },
          {
            "$ref": "https://outpost.dev/schemas/orp/v2/command.schema.json"
          },
          {
            "$ref": "https://outpost.dev/schemas/orp/v3/command.schema.json"
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "https://outpost.dev/schemas/orp/v1/event.schema.json"
          },
          {
            "$ref": "https://outpost.dev/schemas/orp/v2/event.schema.json"
          },
          {
            "$ref": "https://outpost.dev/schemas/orp/v3/event.schema.json"
          }
        ]
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "https://outpost.dev/schemas/orp/v1/request.schema.json"
      }
    },
    "result": {
      "$ref": "https://outpost.dev/schemas/orp/v1/result.schema.json"
    }
  },
  "additionalProperties": true
}
