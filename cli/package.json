{
  "name": "@outpost/cli",
  "version": "0.3.1",
  "description": "Outpost CLI — coordinate persistent AI agents and their work",
  "type": "module",
  "bin": {
    "outpost": "./dist/index.js"
  },
  "keywords": [
    "outpost",
    "ai",
    "agents",
    "orchestration",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "cli"
  },
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node --input-type=module -e \"import esbuild from 'esbuild'; import config from './esbuild.config.mjs'; await esbuild.build(config);\" && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@outpost/adapter-claude-local": "workspace:*",
    "@outpost/adapter-codex-local": "workspace:*",
    "@outpost/adapter-utils": "workspace:*",
    "@outpost/db": "workspace:*",
    "@outpost/server": "workspace:*",
    "@outpost/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "dotenv": "^17.4.2",
    "commander": "^15.0.0",
    "embedded-postgres": "^18.1.0-beta.16",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
